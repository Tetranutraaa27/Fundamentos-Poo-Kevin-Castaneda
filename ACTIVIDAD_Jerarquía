#include <iostream>
#include <string>

class EquipoFutbol {
private:
    std::string nombre;

protected:
    int puntosTemporada;

public:
    void setNombre(const std::string& n) {
        nombre = n;
    }

    std::string getNombre() const {
        return nombre;
    }

    void setPuntos(int p) {
        puntosTemporada = p;
    }

    int getPuntos() const {
        return puntosTemporada;
    }
};
